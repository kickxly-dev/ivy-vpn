{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Ivy VPN",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:allow-spawn",
    "fs:read-files",
    "fs:write-files",
    "process:allow-restart"
  ]
}
